# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase / PostgreSQL & PostGIS Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key-backend-only"
DATABASE_URL="postgresql://postgres:password@localhost:5432/gps_fleet_db"

# Server & GPS Gateway Ports
API_PORT=3000
GPS_TCP_PORT=5001
GPS_UDP_PORT=5002
GPS_LISTEN_HOST="0.0.0.0"

# CORS & Security
CORS_ORIGIN="*"
JWT_SECRET="super-secret-jwt-key-change-in-production"

# Map Configuration (OpenStreetMap / Mapbox / Google Maps tile provider)
MAP_PROVIDER="osm"
MAP_API_KEY=""

